@model CategoryVM

<p>Are you sure you want to delete this category?</p>

<div class="d-flex align-items-center gap-2 mb-3">
    <i class="bi @Model.Icon fs-3" style="color:@Model.ThemeColor"></i>
    <strong>@Model.Name</strong>
    <span class="text-muted">(@Html.DisplayFor(m => m.CategoryType))</span>
</div>

<!-- Chỗ hiện thông báo lỗi -->
<div id="deleteError" class="text-danger mb-2"></div>

<form asp-action="Delete" method="post">   @* form này để sinh token *@
    <input type="hidden" asp-for="Id" />
    <button type="button" class="btn btn-danger" onclick="deleteCategory(@Model.Id)">
        <i class="bi bi-trash"></i> Delete
    </button>
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
</form>