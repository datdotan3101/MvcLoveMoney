<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MvcLoveMoney</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-body-tertiary">

    <!-- Centered auth box, no sidebar / header -->
    <main class="min-vh-100 d-flex align-items-center justify-content-center p-3">
        <div class="w-100" style="max-width: 420px;">

            <!-- Brand -->
            <div class="text-center mb-4">
                <span class="d-inline-flex align-items-center gap-2 fs-3 fw-bold text-dark">
                    <i class="bi bi-wallet2 text-primary"></i> MvcLoveMoney
                </span>
            </div>

            <!-- Login / Register form goes here -->
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    @RenderBody()
                </div>
            </div>

            <p class="text-center text-muted small mt-4 mb-0">
                &copy; @DateTime.Now.Year MvcLoveMoney
            </p>
        </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>