@using System.Globalization                                  

<!DOCTYPE html>
<html lang="en" style="scrollbar-gutter: stable;">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MvcLoveMoney</title>

    <!-- 1. Bootstrap (use the template's version if it has one) -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- 2. Icon libraries -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/boxicons@2.1.4/css/boxicons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/remixicon@4.5.0/fonts/remixicon.css" />

    <!-- 3. Template CSS (after Bootstrap) -->
    <link rel="stylesheet" href="~/assets/css/styles.min.css" />

    <!-- 4. Our own CSS (always last) -->
    <link rel="stylesheet" href="~/MvcLoveMoney.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

</head>
<body>
    @{
            // Current controller name, used to highlight the active menu item
            string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

        // NEW: user initials for the avatar, e.g. "An Tran" → "AT"
        // string initials = string.Concat(
        //     AppConfigs.UserName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
        //                        .Select(word => char.ToUpper(word[0])));
    }

    @* REMOVED: the old small-screen top bar (its ☰ button is now inside the new header) *@

    <div class="d-flex">

        <!-- Sidebar: offcanvas on small screens, sticky column on large screens -->
    <aside class="offcanvas-lg offcanvas-start bg-white border-end sticky-lg-top vh-100 flex-shrink-0 overflow-y-auto z-1"
           style="--bs-offcanvas-width: 260px; width: 260px;" tabindex="-1" id="sidebar">

        <!-- Header inside the slide-in panel (small screens only) -->
        <div class="offcanvas-header border-bottom">
            <span class="fs-5 fw-semibold">
                <i class="bi bi-wallet2 text-primary"></i> MvcLoveMoney
            </span>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#sidebar"></button>
        </div>

        <div class="offcanvas-body d-flex flex-column p-3 w-100">

            <!-- Brand (large screens only) -->
            <a class="d-none d-lg-flex align-items-center gap-2 px-2 py-2 mb-3 fs-5 fw-semibold text-dark text-decoration-none"
               asp-controller="Home" asp-action="Index">
                <i class="bi bi-wallet2 text-primary fs-4"></i> MvcLoveMoney
            </a>

            <div class="text-uppercase small fw-semibold text-secondary px-2 mb-2">Menu</div>

            <ul class="nav nav-pills flex-column gap-1">
                <li class="nav-item">
                    <a class="nav-link d-flex align-items-center gap-2 @(currentController == "Home" ? "active" : "text-body")"
                       asp-controller="Home" asp-action="Index">
                        <i class="bi bi-grid-1x2"></i> Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link d-flex align-items-center gap-2 @(currentController == "Transactions" ? "active" : "text-body")"
                       asp-controller="Transactions" asp-action="Index">
                        <i class="bi bi-arrow-left-right"></i> Transactions
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link d-flex align-items-center gap-2 @(currentController == "Categories" ? "active" : "text-body")"
                       asp-controller="Categories" asp-action="Index">
                        <i class="bi bi-tags"></i> Categories
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link d-flex align-items-center gap-2 @(currentController == "Settings" ? "active" : "text-body")"
                       asp-controller="Settings" asp-action="Index">
                        <i class="bi bi-gear"></i> Settings
                    </a>
                </li>
            </ul>

            <!-- Bottom of the sidebar -->
            <div class="mt-auto px-2 pt-3 small text-muted">
                &copy; @DateTime.Now.Year MvcLoveMoney
            </div>
        </div>
    </aside>

        <!-- NEW: right column = header + page content -->
        <div class="flex-grow-1 d-flex flex-column min-vh-100" style="min-width: 0;">

            <!-- ===================== NEW: HEADER ===================== -->
            <!-- ===================== HEADER ===================== -->
    <header class="app-topbar sticky-top d-flex align-items-center gap-3 px-4 py-3 z-0 mt-1 bg-white">

        <!-- Sidebar button (small screens only) -->
        <button class="btn btn-light border btn-sm d-lg-none" type="button"
                data-bs-toggle="offcanvas" data-bs-target="#sidebar" aria-controls="sidebar">
            <i class="bi bi-list fs-5"></i>
        </button>

        <!-- Page title + subtitle -->
        <div class="me-auto">
            <h1 class="h3 fw-bold mb-0">@ViewData["Title"]</h1>
            @if (ViewData["Subtitle"] != null)
            {
                <p class="text-secondary mb-0 d-none d-sm-block">@ViewData["Subtitle"]</p>
            }
        </div>

        <!-- Today -->
        <div class="d-none d-md-flex align-items-center gap-2 px-3 py-2 rounded-pill bg-white shadow-sm text-secondary small">
            <i class="bi bi-calendar3"></i>
            @DateTime.Today.ToString("dd MMM yyyy", CultureInfo.InvariantCulture)
        </div>

                <!-- Profile / Log in -->
                <partial name="_LoginPartial" />
    </header>

            <!-- Page content (unchanged, only moved inside the right column) -->
            <main class="main-content flex-grow-1 p-4">
                @RenderBody()
            </main>
        </div>
    </div>

     @await RenderSectionAsync("Modals", required: false)
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>