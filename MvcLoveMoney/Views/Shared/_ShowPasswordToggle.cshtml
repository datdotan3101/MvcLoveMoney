@* "Show password" checkbox. Put it inside a <form>; it toggles every password input of that form (wwwroot/js/password-toggle.js). *@
@{
    var checkboxId = "showPassword-" + Guid.NewGuid().ToString("N")[..8];
}
<div class="form-check mb-3">
    <input class="form-check-input" type="checkbox" id="@checkboxId" data-show-password />
    <label class="form-check-label small" for="@checkboxId">Show password</label>
</div>
