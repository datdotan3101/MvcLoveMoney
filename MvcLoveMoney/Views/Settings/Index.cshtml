@model SettingsVM
@{
    ViewData["Title"] = "Settings";
    ViewData["Subtitle"] = "Manage your profile and password";
}

<partial name="_SuccessToast" />

<div class="row g-4">

    <!-- ===================== PROFILE ===================== -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <h2 class="h5 fw-bold mb-1"><i class="bi bi-person me-1"></i> Profile</h2>
                <p class="text-secondary small mb-4">
                    Member since @Model.CreatedAt.ToString("dd/MM/yyyy")
                </p>

                <form asp-action="UpdateProfile" method="post">
                    <div class="mb-3">
                        <label asp-for="Profile.FullName" class="form-label"></label>
                        <input asp-for="Profile.FullName" class="form-control" />
                        <span asp-validation-for="Profile.FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Profile.Email" class="form-label"></label>
                        <input asp-for="Profile.Email" class="form-control" />
                        <span asp-validation-for="Profile.Email" class="text-danger small"></span>
                    </div>

                    <div class="d-flex align-items-center gap-2 mb-4 small">
                        <i class="bi bi-google text-danger"></i>
                        @if (Model.HasGoogle)
                        {
                            <span>Google account linked</span>
                        }
                        else
                        {
                            <span class="text-secondary">Google account not linked</span>
                        }
                    </div>

                    <button type="submit" class="btn btn-primary">Save profile</button>
                </form>
            </div>
        </div>
    </div>

    <!-- ===================== PASSWORD ===================== -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                @if (Model.HasPassword)
                {
                    <h2 class="h5 fw-bold mb-1"><i class="bi bi-shield-lock me-1"></i> Change password</h2>
                    <p class="text-secondary small mb-4">Enter your current password to choose a new one.</p>

                    <form asp-action="ChangePassword" method="post">
                        <div class="mb-3">
                            <label asp-for="ChangePassword.CurrentPassword" class="form-label"></label>
                            <input asp-for="ChangePassword.CurrentPassword" class="form-control" />
                            <span asp-validation-for="ChangePassword.CurrentPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ChangePassword.NewPassword" class="form-label"></label>
                            <input asp-for="ChangePassword.NewPassword" class="form-control" />
                            <div class="form-text">@MvcLoveMoney.Helpers.StrongPasswordAttribute.Hint</div>
                            <span asp-validation-for="ChangePassword.NewPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ChangePassword.ConfirmPassword" class="form-label"></label>
                            <input asp-for="ChangePassword.ConfirmPassword" class="form-control" />
                            <span asp-validation-for="ChangePassword.ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <partial name="_ShowPasswordToggle" />

                        <button type="submit" class="btn btn-primary">Change password</button>
                    </form>
                }
                else
                {
                    <h2 class="h5 fw-bold mb-1"><i class="bi bi-key me-1"></i> Set a password</h2>
                    <p class="text-secondary small mb-4">
                        You signed up with Google, so your account has no password yet.
                        Set one to also log in with your email and password.
                    </p>

                    <form asp-action="SetPassword" method="post">
                        <div class="mb-3">
                            <label asp-for="SetPassword.NewPassword" class="form-label"></label>
                            <input asp-for="SetPassword.NewPassword" class="form-control" />
                            <div class="form-text">@MvcLoveMoney.Helpers.StrongPasswordAttribute.Hint</div>
                            <span asp-validation-for="SetPassword.NewPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="SetPassword.ConfirmPassword" class="form-label"></label>
                            <input asp-for="SetPassword.ConfirmPassword" class="form-control" />
                            <span asp-validation-for="SetPassword.ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <partial name="_ShowPasswordToggle" />

                        <button type="submit" class="btn btn-primary">Set password</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
