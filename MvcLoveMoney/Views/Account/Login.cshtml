@model MvcLoveMoney.ViewModels.LoginVM
@{
    ViewData["Title"] = "Log in";
}

<h1 class="h4 fw-bold mb-1">Welcome back</h1>
<p class="text-secondary mb-4">Log in to manage your money.</p>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success small">
        <i class="bi bi-check-circle me-1"></i> @TempData["SuccessMessage"]
    </div>
}

<form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" placeholder="you@example.com" autofocus />
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <div class="mb-4">
        <div class="d-flex justify-content-between align-items-baseline">
            <label asp-for="Password" class="form-label"></label>
            <a asp-action="ForgotPassword" class="small">Forgot password?</a>
        </div>
        <input asp-for="Password" class="form-control" />
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-primary w-100">Log in</button>
</form>

<p class="text-center mt-4 mb-0 small">
    Don't have an account? <a asp-action="Register">Sign up</a>
</p>

<partial name="_GoogleLoginButton" />
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger small">@TempData["ErrorMessage"]</div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}