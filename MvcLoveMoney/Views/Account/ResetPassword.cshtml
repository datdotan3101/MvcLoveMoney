@model MvcLoveMoney.ViewModels.ResetPasswordVM
@{
    ViewData["Title"] = "Reset password";
}

<h1 class="h4 fw-bold mb-1">Choose a new password</h1>
<p class="text-secondary mb-4">Code verified for <strong class="text-body">@Model.Email</strong>.</p>

<form asp-action="ResetPassword" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
    <input type="hidden" asp-for="Email" />
    <input type="hidden" asp-for="Token" />

    <div class="mb-3">
        <label asp-for="NewPassword" class="form-label"></label>
        <input asp-for="NewPassword" class="form-control" autofocus />
        <div class="form-text">@MvcLoveMoney.Helpers.StrongPasswordAttribute.Hint</div>
        <span asp-validation-for="NewPassword" class="text-danger small"></span>
    </div>

    <div class="mb-4">
        <label asp-for="ConfirmPassword" class="form-label"></label>
        <input asp-for="ConfirmPassword" class="form-control" />
        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
    </div>

    <partial name="_ShowPasswordToggle" />

    <button type="submit" class="btn btn-primary w-100">Reset password</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
