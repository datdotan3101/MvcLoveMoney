<div class="d-flex align-items-center my-4">
    <hr class="flex-grow-1" />
    <span class="px-3 text-secondary small">or</span>
    <hr class="flex-grow-1" />
</div>

<form asp-controller="Account" asp-action="ExternalLogin"
      asp-route-provider="Google"
      asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
    <button type="submit" class="btn btn-outline-secondary w-100 d-flex align-items-center justify-content-center gap-2">
        <i class="bi bi-google text-danger"></i> Continue with Google
    </button>
</form>