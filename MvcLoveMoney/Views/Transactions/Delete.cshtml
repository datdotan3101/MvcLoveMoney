@model TransactionVM

<p>Are you sure you want to delete this transaction?</p>


<!-- Chỗ hiện thông báo lỗi -->
<div id="deleteError" class="text-danger mb-2"></div>

<div class="mb-3">
    <div>
        <i class="@Model.CategoryIcon fs-5 align-middle" style="color:@Model.CategoryThemeColor"></i>
        @Model.CategoryName
    </div>
    <strong>@Model.Name</strong>
    <div class="text-muted">
        @Model.TransactionDate.ToString("dd/MM/yyyy") · @Model.Amount?.ToString("N0")
    </div>
</div>
<form asp-action="Delete" method="post">   @* form này để sinh token *@
    <button type="button" class="btn btn-danger" onclick="deleteTransaction('@IdProtector.Protect(Model.Id)')">
        <i class="bi bi-trash"></i> Delete
    </button>
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
</form>
