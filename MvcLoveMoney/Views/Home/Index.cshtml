@model DashboardVM
@using MvcLoveMoney.Configs
@using System.Text.Json
@{
    ViewData["Title"] = "Dashboard";
    ViewData["Subtitle"] = "Overview of " + Model.CurrentMonth.ToString("MM/yyyy");

    // Data for the charts (read by the script at the bottom)
    var chartData = new
    {
        labels = Model.Months.Select(m => m.Month.ToString("MM/yyyy")),
        income = Model.Months.Select(m => m.Income),
        expense = Model.Months.Select(m => m.Expense),
        categories = Model.ExpenseByCategory.Select(c => new { c.Name, c.Color, c.Amount, c.Percent })
    };
}

@functions {
    // Small "▲ 12% vs last month" line under each card.
    // higherIsGood = false for expense (spending more is bad).
    private Microsoft.AspNetCore.Html.IHtmlContent Change(decimal current, decimal previous, bool higherIsGood = true)
    {
        var percent = DashboardVM.PercentChange(current, previous);
        if (percent == null)
            return new Microsoft.AspNetCore.Html.HtmlString("<span class=\"text-secondary\">No data last month</span>");

        bool up = percent >= 0;
        bool good = up == higherIsGood;
        string icon = up ? "bi-arrow-up-right" : "bi-arrow-down-right";
        string color = percent == 0 ? "text-secondary" : (good ? "text-success" : "text-danger");

        return new Microsoft.AspNetCore.Html.HtmlString(
            $"<span class=\"{color} fw-semibold\"><i class=\"bi {icon}\"></i> {Math.Abs(percent.Value):N1}%</span>"
            + " <span class=\"text-secondary\">vs last month</span>");
    }
}

<style>
    .dash-card-icon {
        width: 48px;
        height: 48px;
    }

    .dash-chart {
        position: relative;
        height: 320px;
    }

    .dash-pie {
        position: relative;
        height: 240px;
    }

    .dash-swatch {
        width: 10px;
        height: 10px;
        border-radius: 3px;
        flex-shrink: 0;
    }
</style>

<!-- ===================== CARDS ===================== -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex gap-3">
                <span class="dash-card-icon d-inline-flex align-items-center justify-content-center rounded-3 bg-primary-subtle text-primary fs-4">
                    <i class="bi bi-wallet2"></i>
                </span>
                <div>
                    <div class="text-secondary small">Total balance</div>
                    <div class="fs-4 fw-bold">@Model.TotalBalance.ToString("N0") <small class="fs-6 text-secondary">@AppConfigs.Currency</small></div>
                    <div class="small text-secondary">All time</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex gap-3">
                <span class="dash-card-icon d-inline-flex align-items-center justify-content-center rounded-3 bg-info-subtle text-info fs-4">
                    <i class="bi bi-calendar-check"></i>
                </span>
                <div>
                    <div class="text-secondary small">Balance this month</div>
                    <div class="fs-4 fw-bold">@Model.MonthBalance.ToString("N0") <small class="fs-6 text-secondary">@AppConfigs.Currency</small></div>
                    <div class="small">@Change(Model.MonthBalance, Model.PrevMonthBalance)</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex gap-3">
                <span class="dash-card-icon d-inline-flex align-items-center justify-content-center rounded-3 bg-success-subtle text-success fs-4">
                    <i class="bi bi-arrow-down-left"></i>
                </span>
                <div>
                    <div class="text-secondary small">Income this month</div>
                    <div class="fs-4 fw-bold">@Model.MonthIncome.ToString("N0") <small class="fs-6 text-secondary">@AppConfigs.Currency</small></div>
                    <div class="small">@Change(Model.MonthIncome, Model.PrevMonthIncome)</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex gap-3">
                <span class="dash-card-icon d-inline-flex align-items-center justify-content-center rounded-3 bg-danger-subtle text-danger fs-4">
                    <i class="bi bi-arrow-up-right"></i>
                </span>
                <div>
                    <div class="text-secondary small">Expense this month</div>
                    <div class="fs-4 fw-bold">@Model.MonthExpense.ToString("N0") <small class="fs-6 text-secondary">@AppConfigs.Currency</small></div>
                    <div class="small">@Change(Model.MonthExpense, Model.PrevMonthExpense, higherIsGood: false)</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">

    <!-- ===================== BAR CHART: income vs expense per month ===================== -->
    <div class="col-xl-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <h2 class="h5 fw-bold mb-0">Income vs expense</h2>

                    <!-- Range filter -->
                    <div class="btn-group btn-group-sm" role="group" aria-label="Range">
                        <a class="btn @(Model.MonthCount == 6 ? "btn-primary" : "btn-outline-primary")"
                           asp-action="Index" asp-route-months="6">6 months</a>
                        <a class="btn @(Model.MonthCount == 12 ? "btn-primary" : "btn-outline-primary")"
                           asp-action="Index" asp-route-months="12">12 months</a>
                    </div>
                </div>

                <div class="dash-chart">
                    <canvas id="incomeExpenseChart" role="img"
                            aria-label="Bar chart of income and expense for the last @Model.MonthCount months. The same numbers are in the monthly comparison table."></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- ===================== PIE CHART: expense by category ===================== -->
    <div class="col-xl-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <h2 class="h5 fw-bold mb-1">Expense by category</h2>
                <p class="text-secondary small mb-3">@Model.CurrentMonth.ToString("MM/yyyy")</p>

                @if (!Model.ExpenseByCategory.Any())
                {
                    <div class="text-center text-secondary py-5">
                        <i class="bi bi-pie-chart fs-1 d-block mb-2"></i>
                        No expenses this month yet.
                    </div>
                }
                else
                {
                    <div class="dash-pie mb-3">
                        <canvas id="categoryChart" role="img"
                                aria-label="Pie chart of this month's expenses by category. The legend below lists each amount."></canvas>
                    </div>

                    <!-- Legend with amounts (identity is never color-only) -->
                    <ul class="list-unstyled mb-0 small">
                        @foreach (var slice in Model.ExpenseByCategory)
                        {
                            <li class="d-flex align-items-center gap-2 py-1">
                                <span class="dash-swatch" style="background-color:@slice.Color"></span>
                                <span class="me-auto text-truncate">@slice.Name</span>
                                <span class="fw-semibold">@slice.Amount.ToString("N0")</span>
                                <span class="text-secondary text-end" style="width: 48px;">@slice.Percent.ToString("N1")%</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>

<!-- ===================== MONTHLY COMPARISON TABLE ===================== -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-4" id="monthlyComparison"
         data-url="@Url.Action("MonthlyComparison", "Home")" data-months="@Model.MonthCount">
        <partial name="_MonthlyComparison" model="Model.Comparison" />
    </div>
</div>

@section Scripts {
    <script src="~/assets/libs/chart.js/chart.min.js"></script>
    <script>
        (function () {
            const data = @Html.Raw(JsonSerializer.Serialize(chartData, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase }));
            const currency = '@AppConfigs.Currency';

            // Series colors (categorical slots 1 & 2, colorblind-safe pair)
            const INCOME_COLOR = '#2a78d6';
            const EXPENSE_COLOR = '#eb6834';
            const GRID_COLOR = 'rgba(0, 0, 0, 0.06)';
            const TEXT_COLOR = '#6c757d';

            const fullNumber = new Intl.NumberFormat('en-US');
            const shortNumber = new Intl.NumberFormat('en-US', { notation: 'compact', maximumFractionDigits: 1 });

            Chart.defaults.font.family = getComputedStyle(document.body).fontFamily;
            Chart.defaults.color = TEXT_COLOR;

            // ===== Bar chart: income vs expense =====
            new Chart(document.getElementById('incomeExpenseChart'), {
                type: 'bar',
                data: {
                    labels: data.labels,
                    datasets: [
                        { label: 'Income', data: data.income, backgroundColor: INCOME_COLOR },
                        { label: 'Expense', data: data.expense, backgroundColor: EXPENSE_COLOR }
                    ].map(ds => ({
                        ...ds,
                        borderRadius: 4,          // rounded top, flat on the baseline
                        borderSkipped: 'start',
                        maxBarThickness: 28,
                        categoryPercentage: 0.6,
                        barPercentage: 0.9        // small gap between the two bars
                    }))
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { mode: 'index', intersect: false },   // hover anywhere in the month
                    plugins: {
                        legend: {
                            position: 'top',
                            align: 'end',
                            labels: { usePointStyle: true, pointStyle: 'rectRounded', boxWidth: 10, boxHeight: 10 }
                        },
                        tooltip: {
                            callbacks: {
                                label: ctx => ` ${ctx.dataset.label}: ${fullNumber.format(ctx.parsed.y)} ${currency}`,
                                footer: items => {
                                    const balance = (items[0]?.parsed.y ?? 0) - (items[1]?.parsed.y ?? 0);
                                    return `Balance: ${fullNumber.format(balance)} ${currency}`;
                                }
                            }
                        }
                    },
                    scales: {
                        x: { grid: { display: false } },
                        y: {
                            beginAtZero: true,
                            grid: { color: GRID_COLOR, drawBorder: false },
                            ticks: { callback: value => shortNumber.format(value) }
                        }
                    }
                }
            });

            // ===== Pie chart: expense by category =====
            const pieCanvas = document.getElementById('categoryChart');
            if (pieCanvas) {
                new Chart(pieCanvas, {
                    type: 'pie',
                    data: {
                        labels: data.categories.map(c => c.name),
                        datasets: [{
                            data: data.categories.map(c => c.amount),
                            backgroundColor: data.categories.map(c => c.color),
                            borderColor: '#ffffff',     // 2px gap between slices
                            borderWidth: 2,
                            hoverOffset: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },   // custom legend with amounts is below the chart
                            tooltip: {
                                callbacks: {
                                    label: ctx => {
                                        const c = data.categories[ctx.dataIndex];
                                        return ` ${c.name}: ${fullNumber.format(c.amount)} ${currency} (${c.percent.toFixed(1)}%)`;
                                    }
                                }
                            }
                        }
                    }
                });
            }

            // ===== Monthly comparison: ‹ › arrows load older / newer months by Ajax =====
            const comparison = document.getElementById('monthlyComparison');
            comparison.addEventListener('click', async function (e) {
                const button = e.target.closest('[data-compare-end]');
                if (!button || button.disabled) return;

                const url = `${comparison.dataset.url}?end=${button.dataset.compareEnd}&months=${comparison.dataset.months}`;
                comparison.style.opacity = '0.5';
                try {
                    const response = await fetch(url);
                    if (response.ok) {
                        comparison.innerHTML = await response.text();
                    }
                } finally {
                    comparison.style.opacity = '';
                }
            });
        })();
    </script>
}
